{
  "name": "qa-automation-suite",
  "version": "1.0.0",
  "description": "End-to-end UI and API test automation with Playwright, page objects, reports and CI",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=mobile-chrome",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  },
  "license": "MIT"
}
